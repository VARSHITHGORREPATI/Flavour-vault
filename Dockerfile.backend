FROM node:18-alpine

WORKDIR /app

# Install json-server
COPY package.json ./
RUN npm install json-server@1.0.0-beta.3

# Copy database file and public directory for static assets
COPY details.json ./
COPY public ./public

EXPOSE 3005

CMD ["sh", "-c", "npx json-server --host 0.0.0.0 --port ${PORT:-3005} details.json"]
